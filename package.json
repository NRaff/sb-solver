{
  "name": "sb-solver",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\"",
    "dev:server": "bun --watch src/server.ts",
    "dev:client": "cd client && bunx vite --port 5173",
    "build": "cd client && bunx vite build",
    "start": "NODE_ENV=production bun src/server.ts",
    "typecheck": "cd client && bunx svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "elysia": "^1.2.0",
    "@elysiajs/static": "^1.2.0",
    "@elysiajs/cors": "^1.2.0"
  },
  "devDependencies": {
    "svelte": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "vite": "^6.0.0",
    "typescript": "^5.7.0",
    "svelte-check": "^4.0.0",
    "concurrently": "^9.0.0"
  }
}
